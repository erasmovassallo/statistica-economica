<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!-- Minimal SAS syntax definition for Quarto/Pandoc (skylighting) -->
<language name="SAS" section="Scientific" extensions="*.sas" version="1" kateversion="5.0" casesensitive="0">
  <highlighting>
    <list name="statements">
      <item>data</item><item>run</item><item>quit</item><item>proc</item><item>set</item>
      <item>input</item><item>datalines</item><item>cards</item><item>infile</item><item>file</item>
      <item>put</item><item>output</item><item>keep</item><item>drop</item><item>rename</item>
      <item>if</item><item>then</item><item>else</item><item>do</item><item>end</item><item>to</item>
      <item>by</item><item>where</item><item>var</item><item>class</item><item>model</item>
      <item>tables</item><item>title</item><item>footnote</item><item>libname</item><item>filename</item>
      <item>options</item><item>format</item><item>label</item><item>length</item><item>retain</item>
      <item>array</item><item>merge</item><item>start</item><item>finish</item><item>return</item>
      <item>print</item><item>show</item><item>free</item><item>store</item><item>load</item>
      <item>reset</item><item>delete</item><item>kill</item><item>histogram</item><item>reg</item>
      <item>scatter</item><item>series</item><item>out</item><item>dbms</item><item>replace</item>
      <item>getnames</item><item>delimiter</item><item>datafile</item><item>outfile</item>
      <item>plots</item><item>ods</item><item>use</item><item>read</item><item>into</item><item>all</item>
    </list>
    <list name="procs">
      <item>iml</item><item>print</item><item>means</item><item>freq</item><item>univariate</item>
      <item>sgplot</item><item>import</item><item>export</item><item>datasets</item><item>contents</item>
      <item>sort</item><item>corr</item><item>glm</item><item>autoreg</item><item>arima</item>
      <item>sql</item><item>fcmp</item><item>tabulate</item><item>summary</item><item>transpose</item>
    </list>
    <list name="functions">
      <item>shape</item><item>j</item><item>i</item><item>t</item><item>sum</item><item>mean</item>
      <item>nrow</item><item>ncol</item><item>log</item><item>exp</item><item>sqrt</item>
      <item>abs</item><item>min</item><item>max</item><item>round</item><item>lag</item><item>dif</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*"/>
        <DetectChar attribute="String" context="StringDQ" char="&quot;"/>
        <DetectChar attribute="String" context="StringSQ" char="'"/>
        <keyword attribute="Keyword" context="#stay" String="statements"/>
        <keyword attribute="Proc" context="#stay" String="procs"/>
        <keyword attribute="Function" context="#stay" String="functions"/>
        <Float attribute="Number" context="#stay"/>
        <Int attribute="Number" context="#stay"/>
      </context>
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/"/>
      </context>
      <context name="StringDQ" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context name="StringSQ" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" context="#pop" char="'"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Proc" defStyleNum="dsFunction"/>
      <itemData name="Function" defStyleNum="dsBuiltIn"/>
      <itemData name="Number" defStyleNum="dsDecVal"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
    </itemDatas>
  </highlighting>
  <general>
    <keywords casesensitive="0"/>
    <comments>
      <comment name="multiLine" start="/*" end="*/"/>
    </comments>
  </general>
</language>
